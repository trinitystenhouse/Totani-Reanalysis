{
  "_comment": "Base config for pixel-level emcee validation runs. Uses run_mcmc_from_config.py, not run_global_from_config.py.",

  "counts": "../../../fermi_data/totani/processed/counts_ccube_1000to1000000.fits",
  "expo": "../../../fermi_data/totani/processed/expcube_1000to1000000.fits",
  "templates_dir": "../../../fermi_data/totani/processed/templates",
  "ext_mask": "../../../fermi_data/totani/processed/templates/mask_sources_combined_edep.fits",

  "pixelwise": true,
  "roi_lon": 60.0,
  "roi_lat": 60.0,
  "include_disk": false,
  "disk_cut": 10.0,
  "binsz": 0.125,

  "energy_bins": "all",

  "nwalkers": 64,
  "nsteps": 60000,
  "burn": 10000,
  "thin": 10,

  "energy_bin_workers": "auto",
  "mcmc_workers": 1,

  "mcmc_stat": "poisson",
  "poisson_negative_mode": "strict",
  "poisson_cexp_floor": 1e-30,

  "negative_keys": ["nfw", "fb_neg"],
  "tighten_negative_bounds": false,

  "iso_target_e2": 1e-4,

  "progress": true,
  "no_plots": true,

  "early_stop": true,
  "require_autocorr": false,
  "autocorr_target": 50.0,
  "autocorr_check_every": 5000,
  "autocorr_min_steps": 10000,

  "extra_argv": [
    "--save-chain",
    "--save-logprob",
    "--thin-save",
    "20"
  ],

  "verbosity": 1
}
